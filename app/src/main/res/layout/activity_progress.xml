<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".student.ProgressActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="0dp">

        <include
            android:id="@+id/layoutToolbar"
            layout="@layout/layout_toolbar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Learning Progress"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Track your study journey"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Stats Grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignMargins"
                android:columnCount="2">

                <!-- Study Streak -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.ClassMitra.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔥 Streak"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="5 Days"
                            android:textColor="@color/mitra_purple"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Notes Uploaded -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.ClassMitra.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📚 Notes"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="12"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Quizzes -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.ClassMitra.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📝 Quizzes"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="45"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Flashcards -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.ClassMitra.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🃏 Cards"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="30"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

            <!-- Weekly Activity Placeholder -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="8dp"
                android:text="Weekly Activity"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ClassMitra.Card"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_margin="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom|center_horizontal"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <View android:layout_width="20dp" android:layout_height="60dp" android:layout_marginHorizontal="6dp" android:background="@color/mitra_purple" android:alpha="0.3" />
                    <View android:layout_width="20dp" android:layout_height="100dp" android:layout_marginHorizontal="6dp" android:background="@color/mitra_purple" android:alpha="0.5" />
                    <View android:layout_width="20dp" android:layout_height="40dp" android:layout_marginHorizontal="6dp" android:background="@color/mitra_purple" android:alpha="0.3" />
                    <View android:layout_width="20dp" android:layout_height="120dp" android:layout_marginHorizontal="6dp" android:background="@color/mitra_purple" />
                    <View android:layout_width="20dp" android:layout_height="80dp" android:layout_marginHorizontal="6dp" android:background="@color/mitra_purple" android:alpha="0.5" />
                    <View android:layout_width="20dp" android:layout_height="140dp" android:layout_marginHorizontal="6dp" android:background="@color/mitra_purple" />
                    <View android:layout_width="20dp" android:layout_height="90dp" android:layout_marginHorizontal="6dp" android:background="@color/mitra_purple" android:alpha="0.8" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Subject Performance -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="8dp"
                android:text="Subject Performance"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ClassMitra.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- OS -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Operating Systems – 90%" android:textColor="@color/text_primary" android:textSize="14sp" />
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="16dp" android:progress="90" app:indicatorColor="@color/mitra_purple" app:trackCornerRadius="4dp" />

                    <!-- DBMS -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DBMS – 84%" android:textColor="@color/text_primary" android:textSize="14sp" />
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="16dp" android:progress="84" app:indicatorColor="@color/mitra_purple" app:trackCornerRadius="4dp" />

                    <!-- Java -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Java – 92%" android:textColor="@color/text_primary" android:textSize="14sp" />
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="16dp" android:progress="92" app:indicatorColor="@color/mitra_purple" app:trackCornerRadius="4dp" />

                    <!-- CN -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Computer Networks – 78%" android:textColor="@color/text_primary" android:textSize="14sp" />
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="16dp" android:progress="78" app:indicatorColor="@color/mitra_purple" app:trackCornerRadius="4dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Achievements -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="8dp"
                android:text="Achievements"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:chipSpacing="8dp">

                <com.google.android.material.chip.Chip style="@style/Widget.Material3.Chip.Suggestion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏅 Quiz Master" app:chipCornerRadius="20dp" />
                <com.google.android.material.chip.Chip style="@style/Widget.Material3.Chip.Suggestion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔥 5 Day Streak" app:chipCornerRadius="20dp" />
                <com.google.android.material.chip.Chip style="@style/Widget.Material3.Chip.Suggestion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📚 10 Notes Uploaded" app:chipCornerRadius="20dp" />
                <com.google.android.material.chip.Chip style="@style/Widget.Material3.Chip.Suggestion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🤖 AI Explorer" app:chipCornerRadius="20dp" />

            </com.google.android.material.chip.ChipGroup>

            <!-- Motivational Footer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="32dp"
                android:gravity="center"
                android:text="Great work! Keep learning every day with Mitra 🚀"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="italic" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>